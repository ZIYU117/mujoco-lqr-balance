      </default>
      <default class="calf">
        <joint range="-3.3 0"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" rgba="1 0 0 0.3"/>
        <default class="wheel">
          <geom size="0.022 0 0" condim="6" priority="1" friction="0.8 0.02 0.01"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
