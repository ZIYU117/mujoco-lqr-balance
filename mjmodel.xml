          <joint name="R_thigh2calf" pos="0 0 0" axis="0 1 0" range="-2.61 0" actuatorfrcrange="-23.7 23.7"/>
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="R_calf"/>
